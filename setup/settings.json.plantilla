{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read(~/life/**)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/credentials*.json)",
      "Read(**/token*)"
    ]
  },
  "sandbox": { "enabled": true }
}
